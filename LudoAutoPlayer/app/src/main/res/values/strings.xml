<resources>
    <string name="app_name">Ludo Auto Player</string>
    <string name="app_description">An intelligent auto-player for Ludo King that plays on your behalf using screen analysis and strategic decision making.</string>

    <!-- Accessibility Service -->
    <string name="accessibility_service_label">Ludo Auto Player Service</string>
    <string name="accessibility_service_description">This service allows Ludo Auto Player to interact with Ludo King by performing taps and reading screen content automatically.</string>

    <!-- Permissions -->
    <string name="permission_notifications_title">Notification Permission</string>
    <string name="permission_notifications_desc">Required to show status notifications when the auto-player is running in the background.</string>

    <string name="permission_overlay_title">Display Over Other Apps</string>
    <string name="permission_overlay_desc">Required to display the control overlay panel on top of Ludo King while the auto-player is active.</string>

    <string name="permission_media_projection_title">Screen Capture</string>
    <string name="permission_media_projection_desc">Required to read the Ludo King game screen and detect dice values, piece positions, and turn status.</string>

    <string name="permission_accessibility_title">Accessibility Service</string>
    <string name="permission_accessibility_desc">Required to perform taps on the Ludo King screen to roll the dice and move pieces automatically.</string>

